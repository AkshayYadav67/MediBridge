DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kathmandu
FIELD_ENCRYPTION_KEY=change-me-too
# PostgreSQL (leave POSTGRES_DB empty to use SQLite locally)
POSTGRES_DB=medibridge
POSTGRES_USER=medibridge
POSTGRES_PASSWORD=medibridge
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Email (defaults to console backend)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MediBridge <no-reply@medibridge.local>
# SMS: notifications.sms.ConsoleSMSBackend or notifications.sms.TwilioSMSBackend
SMS_BACKEND=notifications.sms.ConsoleSMSBackend
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
